<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- AppHost composition is exempt from deployable-closure boundaries; see the packages skill. -->
    <EnforceServiceBoundary>false</EnforceServiceBoundary>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Azure.ServiceBus" />
    <PackageReference Include="Concertable.AppHost.Shared" />
    <PackageReference Include="Concertable.Frontend.Hosting" />
    <PackageReference Include="Concertable.B2B.Concert.Contracts" />
    <PackageReference Include="Concertable.B2B.Artist.Contracts" />
    <PackageReference Include="Concertable.B2B.Venue.Contracts" />
    <PackageReference Include="Concertable.Auth.Contracts" />
    <PackageReference Include="Concertable.Payment.Contracts" />
    <ProjectReference Include="..\Modules\Review\Concertable.Customer.Review.Contracts\Concertable.Customer.Review.Contracts.csproj" IsAspireProjectResource="false" />
    <ProjectReference Include="..\Modules\Ticket\Concertable.Customer.Ticket.Contracts\Concertable.Customer.Ticket.Contracts.csproj" IsAspireProjectResource="false" />
  </ItemGroup>

</Project>
