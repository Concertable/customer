{
  "name": "@concertable/customer",
  "version": "0.1.0",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Concertable/concertable.git",
    "directory": "app/customer/shared"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "prebuild": "npm test",
    "build": "npm run clean && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json --resolve-full-paths --resolve-full-extension .js",
    "test": "vitest run src",
    "prepack": "npm run build"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./lib": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js",
      "default": "./dist/lib/index.js"
    },
    "./features/tickets": {
      "types": "./dist/features/tickets/index.d.ts",
      "import": "./dist/features/tickets/index.js",
      "default": "./dist/features/tickets/index.js"
    },
    "./features/preferences": {
      "types": "./dist/features/preferences/index.d.ts",
      "import": "./dist/features/preferences/index.js",
      "default": "./dist/features/preferences/index.js"
    },
    "./features/reviews": {
      "types": "./dist/features/reviews/index.d.ts",
      "import": "./dist/features/reviews/index.js",
      "default": "./dist/features/reviews/index.js"
    },
    "./features/notifications": {
      "types": "./dist/features/notifications/index.d.ts",
      "import": "./dist/features/notifications/index.js",
      "default": "./dist/features/notifications/index.js"
    },
    "./lib/*": {
      "types": "./dist/lib/*.d.ts",
      "import": "./dist/lib/*.js",
      "default": "./dist/lib/*.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "dependencies": {
    "@concertable/shared": "*",
    "@tanstack/react-query": "^5.90.21",
    "@types/qs": "^6.15.0",
    "axios": "^1.13.6",
    "qs": "^6.15.0",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "tsc-alias": "^1.9.1",
    "typescript": "~5.9.3",
    "vitest": "^4.1.10"
  }
}
