# Production SPA build config (bare concertable.co.uk domain). `vite build` (command === 'build')
# reads these; the dev server ignores them (localhost lives in each vite.config.ts). Non-prod cloud
# builds (staging/dev) override per-env via CI VITE_* vars — process.env wins over this file.
# The per-app generic VITE_API_URL / VITE_BASE_URL (and b2b's VITE_PAYMENT_API_URL) are derived in
# the vite configs from the *_API_URL vars below, so they are intentionally absent here.
VITE_CUSTOMER_API_URL=https://customer-api.concertable.co.uk/api
VITE_B2B_API_URL=https://b2b-api.concertable.co.uk/api
VITE_SEARCH_API_URL=https://search-api.concertable.co.uk/api
VITE_PAYMENT_API_URL=https://payment-api.concertable.co.uk/api
VITE_AUTH_AUTHORITY=https://auth.concertable.co.uk
VITE_CUSTOMER_WEB_URL=https://customer.concertable.co.uk
VITE_VENUE_WEB_URL=https://venue.concertable.co.uk
VITE_ARTIST_WEB_URL=https://artist.concertable.co.uk
VITE_BUSINESS_URL=https://business.concertable.co.uk
VITE_BUSINESS_WEB_URL=https://business.concertable.co.uk
VITE_USE_MOCK_DASHBOARD=true
# Publishable (client-side) keys — injected by CI at build, blank in git on purpose.
VITE_GOOGLE_MAPS_API_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=
